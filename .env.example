# LLM_PROVIDER selects the backend in src/agents/bedrock_llm.py: "bedrock", "anthropic", or "groq".
# All three implement the same LangChain chat model interface, so every agent works
# unmodified regardless of which one is active — this is a one-line swap.
LLM_PROVIDER=groq

# --- AWS Bedrock (production target; Claude via Bedrock) ---
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
# Many regions require a cross-region inference profile ID rather than a bare
# model ID for Claude models, e.g. "eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
# for EU regions or "us.anthropic.claude-3-5-sonnet-20241022-v2:0" for US regions.
# Find valid IDs with: aws bedrock list-inference-profiles --region <your-region>
# Note: Claude models on Bedrock also require an AWS Marketplace subscription,
# which requires a valid payment method on the AWS account even for $0 usage.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Direct Anthropic API (alternative; requires Anthropic account credit) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Groq (free tier, no payment method required; get a key at console.groq.com) ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database path (default is fine for local dev)
DB_PATH=data/clinical_trial.db
